{
	"name": "designcart/dc_jwebp",
	"description": "Joomla system plugin that converts JPG/PNG images to WebP and enables native lazy loading",
	"type": "joomla-plugin",
	"license": "GPL-3.0-only",
	"authors": [
		{
			"name": "Design Cart",
			"homepage": "https://www.designcart.pl"
		}
	],
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"rector/rector": "^2.0",
		"squizlabs/php_codesniffer": "^3.10"
	},
	"scripts": {
		"php:lint": "vendor/bin/phpcs -p -s",
		"php:lint:errors": "vendor/bin/phpcs -p -s --runtime-set ignore_warnings_on_exit 1",
		"php:lint:autofix": "vendor/bin/phpcbf",
		"php:rector": "vendor/bin/rector process --dry-run",
		"php:rector:fix": "vendor/bin/rector process",
		"php:rector:clear-cache": "vendor/bin/rector clear-cache",
		"php:rector:fix:lint": [
			"@php:rector:fix",
			"vendor/bin/phpcbf || true",
			"@php:lint"
		],
		"build": "@php bin/package.php",
		"production": [
			"@php:rector",
			"@php:lint",
			"@build"
		]
	},
	"scripts-descriptions": {
		"build": "Packs src/ and LICENSE.md into dist/plg_system_dc_jwebp-<version>.zip",
		"production": "Runs Rector (dry-run) and PHPCS, then builds the installable ZIP"
	},
	"config": {
		"platform": {
			"php": "8.3"
		},
		"sort-packages": true
	}
}
